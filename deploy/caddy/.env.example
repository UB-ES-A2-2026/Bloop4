# Domini i adreces públiques (DuckDNS). Copia aquest fitxer com a .env a /opt/bloop4/caddy.
BASE_DOMAIN=bloop4.duckdns.org
PROD_ADDRESS=www.bloop4.duckdns.org
STAGING_ADDRESS=dev.bloop4.duckdns.org
# Token de duckdns.org, per demanar el certificat. És secret: només va al .env de la VM.
DUCKDNS_API_TOKEN=
