COOKIE_SECURE=false

# Pagaments: `mock` (passarel·la simulada) o `stripe`. Amb stripe calen les dues claus de sota,
# sempre de proves (sk_test_… o, millor, una clau restringida rk_test_…). No les pugis mai al repositori.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
