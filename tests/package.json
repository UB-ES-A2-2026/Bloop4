{
  "name": "bloop4-tests",
  "private": true,
  "version": "0.1.0",
  "description": "Eines de QA de Bloop4: lint, cobertura, proves E2E i informes",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "lint:fix": "node scripts/lint.mjs --fix",
    "coverage:api": "node scripts/coverage.mjs api",
    "coverage:frontend": "node scripts/coverage.mjs frontend",
    "audit": "node scripts/audit.mjs",
    "e2e:up": "node scripts/e2e-stack.mjs up",
    "e2e:down": "node scripts/e2e-stack.mjs down",
    "e2e:logs": "node scripts/e2e-stack.mjs logs",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:ui": "playwright test --ui --project=chromium",
    "e2e:report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0"
  }
}
